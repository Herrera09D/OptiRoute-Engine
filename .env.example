# ===========================================
# OptiRoute-Engine - Variables de Entorno
# ===========================================

# ===========================================
# GENERAL
# ===========================================
NODE_ENV=development

# ===========================================
# API GATEWAY
# ===========================================
GATEWAY_PORT=8080
JWT_SECRET=optiroute-jwt-secret-key-2024-change-in-production
ORDER_SERVICE_URL=http://order-service:8081
ROUTING_SERVICE_URL=http://routing-engine:8082

# ===========================================
# ORDER SERVICE
# ===========================================
ORDER_SERVICE_PORT=8081
DB_HOST_ORDER=postgres-order
DB_PORT_ORDER=5432
DB_USER=optiroute
DB_PASSWORD=optiroute123
DB_NAME_ORDER=order_db

# ===========================================
# ROUTING ENGINE
# ===========================================
ROUTING_SERVICE_PORT=8082
DB_HOST_ROUTING=postgres-routing
DB_PORT_ROUTING=5432
DB_NAME_ROUTING=routing_db

# ===========================================
# POSTGRES (Ambos servicios)
# ===========================================
DB_USER=optiroute
DB_PASSWORD=optiroute123
DB_PORT_ORDER=5432
DB_PORT_ROUTING=5433

# ===========================================
# REDIS
# ===========================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379

# ===========================================
# RABBITMQ
# ===========================================
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672
RABBITMQ_USER=optiroute
RABBITMQ_PASSWORD=optiroute123
RABBITMQ_URL=amqp://optiroute:optiroute123@rabbitmq:5672

# ===========================================
# DOCKER COMPOSE
# ===========================================
DB_PORT_ORDER=5432
DB_PORT_ROUTING=5433
REDIS_PORT=6379
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672
